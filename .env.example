# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 저장소에 올리지 않습니다.

# Claude API 키. 비워 두면 게임은 규칙 모드로 돌아갑니다(사건 서사·인터뷰·기사 판정이 단순해짐).
ANTHROPIC_API_KEY=

# 공유 접속 코드. 바깥에서 들어온 사람은 이 코드를 넣어야 AI를 씁니다. 비워 두면 바깥 접속자에게 AI를 열지 않습니다.
ACCESS_CODE=

# 바깥 접속자의 한도 (비워 두면 기본값)
# DAILY_BUDGET_USD=2
# PER_CLIENT_DAILY_CALLS=1500
# PER_CLIENT_PER_MINUTE=45

# 서버 포트 (기본 5173)
# PORT=5173
