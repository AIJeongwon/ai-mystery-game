# 로컬 비밀번호와 키가 들어가는 환경 설정은 추적하지 않습니다.
.env
.env.*
!.env.example

# 받아서 쓰는 것과 실행 중 생기는 것
node_modules/
*.log
server/usage.json

# 저장소에 올리지 않는 큰 파일: 가공 전 원본 이미지, 터널 실행 파일
tools/_raw/
tools/bin/

# 3D 에셋은 당분간 각자 로컬에 둔다 (블록아웃·사실화 glb, 소품, 인물)
public/assets/3d/

# 운영체제가 만드는 파일
.DS_Store
Thumbs.db

# Blender 스크립트를 Python으로 돌릴 때 생기는 파일
__pycache__/
